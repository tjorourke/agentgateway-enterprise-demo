# Copy to .env.local (gitignored) and fill in. The notebook's Setup cell and the
# scripts source .env.local automatically — secrets never live in a notebook cell
# or in git.
#
#   cp env.example .env.local && $EDITOR .env.local
#
# Already have Solo creds in an existing env file? Point SECRETS_FILE at it
# instead of (or as well as) filling these in — the Setup cell sources both.

# ── required for the local kagent path ───────────────────────────────────────
# Agent model. Anthropic key (sk-ant-...). Used by the agent in both runtimes.
export ANTHROPIC_API_KEY=""
# Solo Enterprise for kagent license.
export SOLO_LICENSE_KEY=""

# ── required only for the AWS Bedrock AgentCore path ─────────────────────────
# Your AWS CLI profile (SSO-backed). The notebook runs `aws sso login` with it.
# Leave region as-is unless your account/AgentCore live elsewhere.
export AWS_PROFILE=""
export AWS_REGION="us-east-1"

# AgentCore clones the agent SOURCE from git at deploy time, so it needs a repo
# it can reach. setup-env.sh creates one for you (gh) and fills these in.
export AGENT_GIT_URL=""                            # e.g. https://github.com/<you>/agentregistry-agentcore-demo.git
export AGENT_GIT_BRANCH="main"
export AGENT_GIT_SUBFOLDER="artifacts/summarizer"

# ── optional overrides (sensible defaults in scripts/lib.sh) ─────────────────
# export CLUSTER_NAME="agentcore-demo"
# export ARCTL_VERSION="v2026.5.4"
# Point at an existing env file with the Solo/Anthropic exports above:
# export SECRETS_FILE="$HOME/path/to/secrets.sh"
